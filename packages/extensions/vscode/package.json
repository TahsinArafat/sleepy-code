{
  "name": "sleepy-code",
  "displayName": "Sleepy Code",
  "description": "AI-powered code assistance via Sleepy Gateway",
  "version": "0.0.1",
  "publisher": "sleepy-ai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:sleepy.chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sleepy.chat",
        "title": "Sleepy: Open Chat"
      },
      {
        "command": "sleepy.login",
        "title": "Sleepy: Login (opens terminal)"
      },
      {
        "command": "sleepy.autocomplete.toggle",
        "title": "Sleepy: Toggle Autocomplete"
      },
      {
        "command": "sleepy.refreshModels",
        "title": "Sleepy: Refresh Models"
      }
    ],
    "keybindings": [
      {
        "command": "sleepy.chat",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sleepy-sidebar",
          "title": "Sleepy",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "sleepy-sidebar": [
        {
          "type": "webview",
          "id": "sleepy.chat",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.5.0"
  }
}
